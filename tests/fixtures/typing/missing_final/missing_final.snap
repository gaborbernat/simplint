from typing import Annotated, Final
from typing import NewType, TypeVar

import logging

COUNT: Final[int] = 3
NAME: Final[str] = "simplint"
RATE: Final[float] = 0.5
FLAG: Final[bool] = True
DATA: Final[bytes] = b"x"
LOGGER = logging.getLogger(__name__)
LIMIT: Final[int] = 10
ALREADY: "Final[int]" = 1
CHANGED = 1
CHANGED = 2
Alias = int
__version__ = "1.0"
FIRST, SECOND = 1, 2
T = TypeVar("T")
UserId = NewType("UserId", int)
OPTIONAL: Final[int | None] = 1
QUALIFIED: Annotated[Final[int], "doc"] = 2
DESCRIBED: Final[Annotated[int, "doc"]] = 3

TYPE_CHECKING = False

JSON = dict[str, Any]
MODE = Literal["a", "b"]
_path_t = str | bytes
MAYBE = int | None
FLAGS = READ | WRITE
TIMEOUT: Final[int] = 1
Timeout: Final[int] = 1
WINDOW: typing.Final[int] = 5
UNKNOWN: Final = compute()
SIZE: Final[int] = 6
TAGGED: Annotated[Final[int], "x"] = 7
