import os
import types
from collections.abc import Mapping, Sequence
from typing import Final, List

SUFFIXES = (".py", ".pyi")
ONE = ("only",)
ONE_COMMA = ("only",)
SQUARES = tuple(value * value for value in range(10))
LETTERS = frozenset({"a", "b"})
EVENS = frozenset({value for value in range(10) if value % 2 == 0})
CODES = frozendict({"ok": 200})
INVERSE = frozendict({code: name for name, code in CODES.items()})
FROM_CALL = tuple(os.sep)
SET_CALL = frozenset("abc")
DICT_CALL = frozendict(a=1)
_PRIVATE = ("x",)
lower: Final = ("y",)
TYPED: tuple[str, ...] = ("z",)
TYPED_BARE: tuple = ("z",)
FINAL_TYPED: Final[frozenset[int]] = frozenset({1})
FINAL_DICT: Final[frozendict[str, int]] = frozendict({"a": 1})
ABSTRACT: Sequence[str] = ("a",)
MAPPING: Mapping[str, int] = frozendict({"a": 1})
TYPING_LIST: List[str] = ["a"]
QUOTED: "list[str]" = ["a"]

CHANGED = []
SUBSCRIPT_WRITTEN = {}
DELETED = {"a": 1}
RETURNED = ["a"]
PASSED = ["a"]
REBOUND = ["a"]
REBOUND = ["b"]
AUGMENTED = ["a"]
lowercase = ["a"]
__all__ = ["reader"]
TUPLE = ("a",)
OTHER_CALL = sorted("abc")


def reader(key: str) -> object:
    for suffix in SUFFIXES:
        print(suffix)
    if ONE and len(ONE_COMMA) > 0:
        print(SQUARES[0], [*LETTERS], {**CODES}, INVERSE.get(1))
    while key in EVENS:
        break
    assert FROM_CALL
    print(sorted(SET_CALL), DICT_CALL.items(), _PRIVATE + lower, -len(TYPED), TYPED_BARE)
    print({item for item in FINAL_TYPED if item in FINAL_DICT}, ABSTRACT, MAPPING, TYPING_LIST, QUOTED)
    print(",".join(SUFFIXES), not TYPED, CODES.keys() | {"x"})
    CHANGED.append(key)
    SUBSCRIPT_WRITTEN[key] = 1
    del DELETED["a"]
    PASSED.sort()
    print(lowercase, TUPLE, OTHER_CALL, REBOUND)
    return RETURNED


def extend() -> None:
    global AUGMENTED
    AUGMENTED += ["b"]


def shadow() -> list[str]:
    LOCAL_ONLY = ["a"]
    return LOCAL_ONLY
