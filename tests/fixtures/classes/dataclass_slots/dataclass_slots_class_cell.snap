from dataclasses import dataclass


@dataclass(slots=True)
class Release:
    version: str

    def label(self) -> str:
        return super().__repr__()


@dataclass(slots=True)
class Nested:
    version: str

    def label(self) -> str:
        def describe(item: "Nested") -> str:
            return super().__repr__()

        return describe(self)


@dataclass(slots=True)
class Lambda:
    version: str

    def label(self) -> str:
        return (lambda item: super().__repr__())(self)


@dataclass(slots=True)
class Kind:
    version: str

    def kind(self) -> type:
        return __class__


@dataclass(slots=True)
class Explicit:
    version: str

    def label(self) -> str:
        return super(Explicit, self).__repr__()


@dataclass(slots=True)
class Attribute:
    version: str

    def kind(self) -> type:
        return self.__class__
