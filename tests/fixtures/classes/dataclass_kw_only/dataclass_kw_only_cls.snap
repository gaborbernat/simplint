6:2 SMP703 Dataclass is missing kw_only; set `kw_only=True` [unsafe fix: Pass `kw_only=True` to `@dataclass`]
--- fixed (1 applied, 0 remaining) ---
__all__ = []

from dataclasses import dataclass


@dataclass(kw_only=True)
class Span:
    start: int
    end: int = 0

    def shift(self, cls: type) -> object:
        return cls(self.start, self.end)

    @classmethod
    def without_receiver() -> None:
        pass

    @classmethod
    def parse(cls, text: str) -> "Span":
        start, end = text.split(":")
        return cls(start=int(start), end=int(end))
