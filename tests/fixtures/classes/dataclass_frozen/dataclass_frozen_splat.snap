39:2 SMP701 Dataclass is missing frozen; set `frozen=True` [unsafe fix: Pass `frozen=True` to `@dataclass`]
49:2 SMP701 Dataclass is missing frozen; set `frozen=True`
--- fixed (1 applied, 1 remaining) ---
from dataclasses import dataclass
from typing import Final

from dc_options import IMPORTED_KW

DC_KW = {"frozen": True, "slots": True}
SLOTS_KW = {"slots": True}
FROZEN_OFF = {"frozen": False}
MUTATED_KW = {"slots": True}
MUTATED_KW["frozen"] = True
UPDATED_KW = {"slots": True}
UPDATED_KW.update(frozen=True)
FINAL_KW: Final = {"frozen": True}
CALL_KW = dict(frozen=True)
NESTED_KW = {**DC_KW, "slots": True}
REPEATED_KW = {"frozen": True, "frozen": False}
FROZEN_KEY = "frozen"
KEYED_KW = {FROZEN_KEY: True}
SPLAT_CALL_KW = dict(**SLOTS_KW)


def get_kw() -> dict[str, bool]:
    return {"frozen": True}


def make(**kw: bool) -> type:
    @dataclass(**kw)
    class Passed:
        splat_marker: int

    return Passed


@dataclass(**DC_KW)
class Settled:
    splat_marker: int


@dataclass(**SLOTS_KW, frozen=True)
class SlotsOnly:
    splat_marker: int


@dataclass(**get_kw())
class Computed:
    splat_marker: int


@dataclass(**FROZEN_OFF)
class FrozenOff:
    splat_marker: int


@dataclass(**MUTATED_KW)
class Mutated:
    splat_marker: int


@dataclass(**FINAL_KW)
class FinalKeywords:
    splat_marker: int


@dataclass(**UPDATED_KW)
class Updated:
    splat_marker: int


@dataclass(**CALL_KW)
class CallSet:
    splat_marker: int


@dataclass(**NESTED_KW)
class Nested:
    splat_marker: int


@dataclass(**REPEATED_KW)
class Repeated:
    splat_marker: int


@dataclass(**IMPORTED_KW)
class Imported:
    splat_marker: int


@dataclass(**KEYED_KW)
class Keyed:
    splat_marker: int


@dataclass(**SPLAT_CALL_KW)
class SplatCall:
    splat_marker: int
