from dataclasses import dataclass

SLOTS_OFF = {"slots": False}


@dataclass(**SLOTS_OFF, frozen=True)
class SplatSlotsOff:
    splat_marker: int


@dataclass(frozen=True, slots=False)
class KeywordSlotsOff:
    splat_marker: int
