from dataclasses import dataclass

from api import router


class Item:
    name: str


@router.get("/item")
def read_item() -> Item:
    return Item()


@dataclass
class Envelope:
    payload: Payload

    def wrap(self) -> object:
        return Payload()


class Payload:
    pass


class Token:
    pass


def outer() -> object:
    def inner(token: Token) -> None:
        pass

    return inner


def caller() -> object:
    return Helper()


class Helper:
    pass


class Column:
    pass


@router.model
class Row:
    cell: Column

    def fill(self) -> object:
        return Column()
