import itertools

counter = itertools.count()


class Counted:
    first = next(counter)

    def run(self) -> int:
        return self._token()

    def _token(self, token: int = next(counter)) -> int:
        return token


class Plain:
    first = 1

    def run(self) -> int:
        return self._token()

    def _token(self, token: int = 0) -> int:
        return token
