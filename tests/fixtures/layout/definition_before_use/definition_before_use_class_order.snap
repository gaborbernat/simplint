class Session:
    def run(self) -> int:
        return self._check() + self._step()

    def _check(self) -> int:
        return 3

    def __init__(self) -> None:
        self.value = self._load()

    def _load(self) -> int:
        return 2

    @classmethod
    def open(cls) -> "Session":
        session = cls()
        return session._prepare()

    def _prepare(self) -> "Session":
        return self

    def __repr__(self) -> str:
        return str(self._step())

    def _step(self) -> int:
        return 1


class Chain:
    def alpha(self) -> int:
        return self._outer()

    def _outer(self) -> int:
        return self._inner()

    def _inner(self) -> int:
        return 1

    def beta(self) -> int:
        return self._inner()
