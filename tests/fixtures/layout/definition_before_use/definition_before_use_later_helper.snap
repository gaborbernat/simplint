def run() -> list[int]:
    return _cli_args(2)


def _cli_args(count: int) -> list[int]:
    kinds = _written_as(count)
    return [_config_of(index) for index in range(kinds)]


def _written_as(value: int) -> int:
    return value


def _config_of(index: int) -> int:
    return index


def outer() -> int:
    return _first() + _second()


