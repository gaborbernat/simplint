        def helper() -> int:
            return 1

        return cls()

    def __str__(self) -> str:
        return "shape"

    @cached_property
    def area(self) -> int:
        return 2

    @staticmethod
    def unit() -> int:
        return 1

    @classmethod
    def nothing(cls) -> None:
        pass

    @classmethod
    def bare() -> int:
        return 1


class Totals:
    def __init__(self) -> None:
        self.value = 0

    def run(self) -> int:
        return self._total()

    @cache
    def _total(self) -> int:
        return 1


class Pinned:
    def load(self) -> int:
        return self.make()

    def make(self) -> int:
        return 1

    FACTORY = make

    def __init__(self) -> None:
        self.value = 0


class Tied:
    def load(self) -> int:
        return 1

    SCALE = 2

    def __init__(self, scale: int = SCALE) -> None:
        self.scale = scale


class Overloaded:
    def __init__(self) -> None:
        self.value = 0

    def load(self, value: int | str) -> int:
        return 1

    @overload
    def read(self, value: int) -> int: ...

    @overload
    def read(self, value: str) -> str: ...

    def read(self, value: int | str) -> int | str:
        return value


class Recursive:
    def __init__(self) -> None:
        self.value = 0

    def even(self, n: int) -> bool:
        return True if n == 0 else self._odd(n - 1)

    def _odd(self, n: int) -> bool:
        return False if n == 0 else self.even(n - 1)


class ConstructedTwice:
    def __new__(cls) -> "ConstructedTwice":
        return super().__new__(cls)

    def __init__(self) -> None:
        self.value = 0
