from typing import Final

_CODES: dict[str, int] = {"ok": 0}


def lookup(text: str, expected: str) -> str:
    pi_overrides: dict[str, str] = {"<?namespace>": "ProcessingInstruction"}
    if text.endswith(">"):
        return pi_overrides.get(text, expected)
    return expected


def connect() -> int:
    limit: int = 30
    return limit


def mode() -> str:
    return "fast"


def merged() -> dict[str, int]:
    codes = {"error": 1}
    return {**_CODES, **codes}
