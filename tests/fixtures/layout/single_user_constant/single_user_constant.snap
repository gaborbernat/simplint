from typing import Final

print("loading")
_RETRIES = 3
_SHARED = 1
# cached: rebuilding the table on every call is too slow
_TABLE = {"a": 1}
PUBLIC = 5


def connect() -> int:
    timeout: int = 30
    return timeout


def retry() -> int:
    return _RETRIES + _RETRIES + _TABLE["a"]


def first() -> int:
    return _SHARED


def second() -> int:
    return _SHARED + PUBLIC


_PATTERN = "x"


def loop(items: list[str]) -> list[str]:
    return [item for item in items if item == _PATTERN]


def multi() -> str:
    return "a" "b"


def twice(items: list[str]) -> list[str]:
    repeat = 2
    looped = "z"
    return [item for item in items if item == looped][:repeat] * repeat

_LAMBDA_ONLY = 3
HANDLER = lambda: _LAMBDA_ONLY


_WARNED: set[str] = {""}
_CACHE = {}
_LOG = []


def warn_once(message: str) -> None:
    if message not in _WARNED:
        _WARNED.add(message)
    _CACHE[message] = True
    del _CACHE[message]
    _LOG.append(message)


_JWT_CACHE = VerdictCache(maxsize=128)
_LOGGER = logging.getLogger(__name__)
_VERSION_RE = re.compile(r"\d+")
_CONFIG_DIR = Path("~/.config")
_CLIENT = httpx.Client()
_LEVEL = logging.INFO
_ALIAS = PREFIX_BASE
_FORMATTED = f"{PREFIX_BASE}/x"
_SPREAD = [*PARTS]
_MERGED = {**DEFAULTS}
_FLIPPED = -LIMIT_BASE
_LIMIT = 30  # seconds before giving up


def verify(token: str) -> object:
    _LOGGER.info(token)
    found = _JWT_CACHE.get(token) or _VERSION_RE.match(token) or _CONFIG_DIR / token or _CLIENT.get(token)
    return found, _LEVEL, _ALIAS, _FORMATTED, _SPREAD, _MERGED, _FLIPPED, _LIMIT
_SEEN_TYPES: Final[dict[str, int]] = {}


def lookup(key: str) -> int:
    names = ("a", "b")
    return _SEEN_TYPES.get(key, 0) + len(_SEEN_TYPES) + len(names) + len(names)


_FULL = ".".join(str(part) for part in VERSION)


def describe() -> str:
    return f"version {_FULL} on {8080}"


_DERIVED = frozenset(KINDS)


def ignored() -> frozenset:
    return _DERIVED


_TABLE_ROWS = [("a", 1.5), ("b", -2)]
_CODES = {"ok": 0, "error": 1}


def literals() -> tuple[object, ...]:
    return (-1), (60 * 60), b"raw", None, True, _TABLE_ROWS, _CODES


_OPERATORS = {"==": operator.eq}


def compare(operator: str) -> object:
    return _OPERATORS[operator]


def bounds() -> int:
    limits = (1, 2)
    return limits[0] + limits[1]


_SIZES: dict[str, int] = {}


def size(key: str) -> int:
    return _SIZES.get(key, 0) + len(_SIZES)


_ERRORS = (RuntimeError,) if len(__name__) > 3 else ()


def guarded() -> None:
    try:
        print()
    except (ValueError, *_ERRORS):
        pass


_5_SMOOTH = (1, 2, 3)
_CLASS = (4, 5, 6)


def smooth() -> int:
    return _5_SMOOTH[0] + _5_SMOOTH[1] + _CLASS[0] + _CLASS[1]


def choose(**options: tuple[str, ...]) -> None:
    print(options)


def pick() -> None:
    choose(choices=("first", "second"))


def scaled() -> int:
    factor = 3
    base = 1; doubled = factor * factor
    return base + doubled


_WRAPPED: Final[int] = (
    3  # the trailing comment `ruff format` moved inside the parentheses
