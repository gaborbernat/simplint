def wrapped() -> int:
    return _WRAPPED


class Links:
    def render(self, parts: list[str]) -> str:
        root = "https://example.com/"
        return "\n".join(f"{root + part}" for part in parts)

    def prefixed(self, parts: list[str]) -> list[str]:
        """Prefix each part."""
        prefix = "/"
        host = "https://example.org/"
        return [host + prefix + part for part in parts]


def resource(project: str, location: str) -> str:
    resource_pattern = "projects/{}/locations/{}"
    return resource_pattern.format(
        project,
        location,
    )


