import sys

if sys.version_info < (3, 10):
    msg = "requires Python 3.10"
    raise RuntimeError(msg)

with open(__file__) as handle:
    text = handle.read()
    count = len(text)
    print(count)

if sys.platform == "linux":
    _shared = 1
print(_shared)

if sys.platform == "darwin":
    _leaked = 2
print(_leaked)
