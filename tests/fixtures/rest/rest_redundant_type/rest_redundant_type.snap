def scale(value: float, factor) -> float:
    """Scale a value.

    :param value: The value.
    :param factor: The factor.
    :type factor: float
    """
    return value * factor


def inline(value: float, factor) -> None:
    """Scale a value.

    :param value: The value.
    :param float factor: The factor.
    """


class Scaler:
    """Scale values.

    :param factor: The factor.
    """

    def __init__(self, factor: float) -> None:
        self.factor = factor
