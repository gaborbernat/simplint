from unittest import TestCase, mock
from unittest.mock import patch


class ConfigTest(TestCase):
    def test_home(self):
        home = self.enterContext(mock.patch("os.getcwd"))
        home.return_value = "/home"

    def test_object(self):
        debug = self.enterContext(mock.patch.object(Config, "debug", True))
        debug.return_value = False

    def test_environment(self):
        environment = self.enterContext(patch.dict("os.environ", {"HOME": "/home"}))
        environment.clear()
