def test_box_holds_value() -> None:
    assert Box[int]().get(1) == 1


def test_box_default[T](value: T | None = None) -> None:
    assert value is None


def test_bounded_sig[T: int, *Ts, **P](args: tuple[*Ts] | None = None, fn: Callable[P, int] | None = None) -> None:
    type Alias = list[T]
    assert Alias.__value__ == list[T]


class TestDefault[T]:
    def test_names_t(self, kind: type = list[T]) -> None:
        assert kind is list


def test_defaulted_uses_default[T: int = int](value: T | None = None) -> None:
    assert value is None


def test_plain_plain() -> None:
    assert 1 == 1
