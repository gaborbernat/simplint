def parse(text: str) -> int:
    return int(text)


def test_parse_error_value() -> None:
    assert parse("1") == 1


class TestParseError:
    def test_value(self) -> None:
        assert parse("2") == 3


def test_parse_warning_value() -> None:
    assert parse("3") == 4
