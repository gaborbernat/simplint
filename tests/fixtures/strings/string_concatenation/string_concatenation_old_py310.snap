def greet(names: dict[str, str]) -> str:
    return f"Hello {names['first']!s} and {names['last']!s}"


def quoted(names: dict[str, str]) -> str:
    return "Hello " + str(names["it's"])


def nested(prefix: str, width: int) -> str:
    return f"{prefix}{'a' + ('b' * width)}"
