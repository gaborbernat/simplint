def first_line(value: int) -> int:
    """Double a value, for example::

        double(2)

    Use :func:`other` for more, with an ``unclosed literal.

    :param value: The input.
    :returns: The double.
    """
    return value * 2


def later_line(value: int) -> int:
    """Double a value.

    For example::

        double(2)

