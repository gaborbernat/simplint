from dataclasses import KW_ONLY, dataclass, field


@dataclass
class Settings:
    """Settings.

    :param name: The name.
    :param retries:
    """

    name: str
    label = "settings"
    _: KW_ONLY
    retries: int = 3
    cache: dict = field(init=False, default_factory=dict)

    def describe(self) -> str:
        return self.name


