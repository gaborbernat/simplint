def check(text: str, data: bytes, parts):
    prefix = text.startswith("foo")
    suffix = text.endswith("bar")
    negated = not text.startswith("//")
    flipped = text.startswith("ab")
    raw = data.startswith(b"\x89PNG")
    joined = (text + "x").startswith("y")
    attribute = parts.name[:5] == "socks"
    unicode = text.startswith("é!")
    return prefix, suffix, negated, flipped, raw, joined, attribute, unicode


def not_affixes(text: str):
    wrong_length = text[:3] == "ab"
    middle = text[1:3] == "ab"
    stepped = text[:4:2] == "ab"
    variable = text[:3] == text
    return wrong_length, middle, stepped, variable


def unknown_receiver(field):
    return field["timeout"][:4] == "2019"
