def show(items):
    for item in items:
        print(item)


def attribute(self):
    for name in self.names:
        print(name)


def position_used(items):
    for i in range(len(items)):
        print(i, items[i])


def written(items):
    for i in range(len(items)):
        items[i] = items[i].strip()


def index_after(items):
    for i in range(len(items)):
        if items[i]:
            break
    return i


def name_taken_elsewhere(tasks):
    for task in tasks:
        print(task)


def bind_task():
    task = 1
    return task


def name_taken(rows):
    row = None
    for i in range(len(rows)):
        print(rows[i], row)


def other_sequence(items, labels):
    for i in range(len(items)):
        print(labels[i])


def index_only(items):
    for i in range(len(items)):
        print(i)


def call_result(load):
    for i in range(len(load())):
        print(load()[i])


def counted(items, count):
    for i in range(count(items)):
        print(items[i])


def no_singular(data):
    for i in range(len(data)):
        print(data[i])


def counter(items):
    total = 0

    def bump():
        nonlocal total
        global LAST
        try:
            for item in items:
                total += item
        except ValueError:
            LAST = None

    bump()
    return total
