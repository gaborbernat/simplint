import re
from re import error


def compile_pattern(text):
    try:
        return re.compile(text)
    except re.PatternError:
        return None


def fail(message):
    raise re.PatternError(message)


def imported(text):
    try:
        return re.compile(text)
    except error:
        return None


def patched(replacement):
    re.error = replacement


def unpatched():
    del re.error
