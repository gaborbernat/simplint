import codecs


def read_walrus(path):
    with open(path, "r", encoding=(name := "utf-8"), newline="") as handle:
        return name, handle.read()


def read_keyword(path):
    with open(path, "r", encoding=(other := "utf-8"), newline="") as handle:
        return other, handle.read()


def read_buffered(path):
    with open(path, "r", buffering=(size := 1), encoding="utf-8", errors="strict", newline="") as handle:
        return size, handle.read()
