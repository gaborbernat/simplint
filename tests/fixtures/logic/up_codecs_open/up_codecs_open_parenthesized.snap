import codecs


def read_yield(path):
    with open(path, "r", encoding="utf-8", errors=(yield), newline="") as handle:
        return handle.read()


def read_parenthesized_walrus(path):
    with open(path, "r", buffering=(size := 1), encoding="utf-8", errors="strict", newline="") as handle:
        return size, handle.read()
