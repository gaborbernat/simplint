calls = 0


def bump() -> int:
    global calls
    calls += 1
    return calls


def unsafe_before_formatted_name(stack: list[int]) -> str:
    top = stack.pop()
    return f"{stack} after popping {top}"


def unsafe_before_double_star(base: dict[str, int], extra: dict[str, int]) -> dict[str, int]:
    added = base.update(extra) or len(base)
    return {**base, "n": added}


def unsafe_before_star(items: list[int]) -> None:
    head = items.pop()
    print([*items], head)


def unsafe_before_keyword_unpacking(options: dict[str, int]) -> None:
    removed = options.pop("a")
    print(**options, removed=removed)


def unsafe_before_global_name() -> None:
    value = bump()
    print(calls, value)


def unsafe_before_nonlocal_name() -> tuple[int, int]:
    total = 0

    def step() -> int:
        nonlocal total
        total += 1
        return total

    value = step()
    return total, value


def inlined_after_parameter(items: list[int], log: list[int]) -> None:
    print(log, len(items))


def inlined_pure_after_formatted_name(stack: list[int], top: int) -> str:
    return f"{stack} after popping {(top + 1)}"


def counted(items: list[int]) -> int:
    return items.count(1) * 2


def paired() -> tuple[int, ...]:
    return (1, 2) * 2


def decorated_reader(items: list[int]) -> object:
    size = len(items)

    @staticmethod
    def helper() -> int:
        return size

    return helper


def any_listed(first: bool, second: bool) -> bool:
    return any([first, second])


def operands_keep_their_order(stack: list) -> float:
    right = evaluate(stack)
    return divide(evaluate(stack), right)
