def produce(rows: list[int]):
    try:
        yield rows[0]
        yield rows[1]
    finally:
        print("closed")


def first_from_next(rows: list[int]) -> None:
    stream = produce(rows)
    print(next(stream))


def first_from_default(rows: list[int]) -> None:
    stream = produce(rows)
    print(next(stream, None))


def reply_from_send(rows: list[int]) -> None:
    stream = produce(rows)
    print(stream.send(None))


def stop_from_close(rows: list[int]) -> None:
    stream = produce(rows)
    stream.close()
    print(rows)


async def first_from_anext(source: AsyncSource) -> None:
    stream = source.items()
    first = await anext(stream)
    print(first)


def collected(rows: list[int]) -> None:
    print(list(produce(rows)))


class Scratch:
    def __init__(self) -> None:
        self.name = "scratch"

    def describe(self) -> str:
        return self.name


def make_scratch() -> Scratch:
    return Scratch()


def name_of_temporary() -> str:
    return make_scratch().name.upper()


def method_on_temporary() -> str:
    return make_scratch().describe()


def part_of_literal() -> str:
    return ("scratch", 1)[0]
