class Counter:
    def __init__(self) -> None:
        self.total = 0

    def bump(self) -> int:
        self.total += 10
        return 1

    def run(self) -> int:
        self.total += self.bump()
        return self.total


def closure() -> int:
    total = 0

    def bump() -> int:
        nonlocal total
        total += 10
        return 1

    total += bump()
    return total


