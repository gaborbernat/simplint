def conversion(value: str) -> str:
    return f"label={value.title()!s}"


def spec(count: int) -> str:
    return f"width={(count * 2):>5}"


def spaces(value: str) -> str:
    return f"label = {value.title()!r}|"


def dict_display(value: str, count: int) -> str:
    return f" {{label: count}}={ {value.title(): count}!r}"


def nested(value: str) -> str:
    label = value.title()
    return f"{f'{label=}'=}"


def template(value: str) -> object:
    label = value.title()
    return t"[{label=}]"


def escaped(items: list[str]) -> str:
    label = items[0]
    return f"{label + '\n'=}"
