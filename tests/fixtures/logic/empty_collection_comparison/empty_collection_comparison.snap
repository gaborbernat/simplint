def check(items, mapping, pair, value, flag):
    if not items:
        return 1
    elif mapping:
        return 2
    while not pair:
        pair = (1,)
    label = "empty" if not (items + []) else "full"
    flags = [items == [], {} == mapping]
    either = flag or items == []
    typed = value == "" or value == [] or value is None
    assert items == []
    return label, flags, either, typed


def literal_both_sides():
    return [] == []


def string(text):
    return text == ""


def tests(items, flag):
    if items:
        return [item for item in items if item]
    if flag and items:
        return bool(not items)
    match flag:
        case True if not items:
            return None
    return bool(items)
