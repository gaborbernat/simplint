def greet(name: str, count: int) -> list[str]:
    return [
        f"Hello, {name}!",
        "ab",
        f"{{braces}} {name}",
        f"{count} items for {name}",
        f'single {name}',
        f"mixed {name} quotes",
        f"call {count!s}",
        "dict " + {"a": name}["a"],
        r"raw " + name,
    ]


DATA = b"a" + b"b"


def more(name: str) -> list[str]:
    return [f"ab{name}", u"c" + name, """d""" + name]


def fstrings(name: str) -> list[str]:
    return [f"ab{name}", rf"c" + name]

name = "world"
COMMENTED = (
    "<a>"  # open
    + name
    + "</a>"
)
CONVERTED = f"a{count!s}b{name!r}"
CALLED = "a" + describe(count)
QUOTED = f'say {name} "hi"'
SPREAD = f"at {format(count)}"
NAMED = "dot " + name + "\N{BULLET}"
