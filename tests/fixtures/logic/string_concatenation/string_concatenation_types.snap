from os import pathsep
from pathlib import Path
from typing import Annotated, Final

from markupsafe import Markup
from pypdf import PageRange

CONCAT_SEPARATOR = "-"
CONCAT_PREFIX: Final[str] = "pre"
concat_counter = 0


def concat_opaque(value, path: Path, items: list[str]) -> list[object]:
    return [
        PageRange(slice(0, 5)) + "2:7",
        Markup("foo") + "bar",
        value + "",
        path + pathsep + "foo",
        f"a{items[0]}",
        "a" + concat_counter,
        "a" + len(items),
    ]


def concat_known(label: str, items: list[str], flag: bool) -> list[str]:
    built = "start"
    built += label
    joined = ", ".join(items)
    return [
        f"{label}!",
        f"{built}?",
        f"{joined}.",
        f"{"ab".replace("a", "c")}{label}.",
        f"{label if flag else "none"}x",
        f"{label.upper()}-{label[0]}",
        f"<{CONCAT_PREFIX}{label}",
        "<" + CONCAT_SEPARATOR + label,
        f"n={flag!s}",
    ]


def concat_rebound(label: str, items: list[str]) -> list[str]:
    for label in items:
        pass
    for label in range(3):
        pass
    looped = [f"{label}!" for label in items]
    shadow = "x"
    shadow = len(items)
    return [label + "?", *looped, "s" + shadow]


def concat_shadowed_builtin(value: int) -> str:
    str = repr
    return "v=" + str(value)


def concat_global(text: str) -> str:
    def reset() -> None:
        global CONCAT_SEPARATOR
        CONCAT_SEPARATOR = 1

    reset()
    return CONCAT_SEPARATOR + text


class ConcatHolder:
    suffix = "!"
    combined = f"a{suffix}"

    def describe(self, suffix=f"{suffix}?") -> str:
        return "b" + suffix


concat_lambda = lambda part: "x" + part


def concat_forms(
    label: str,
    quoted: "str",
    tagged: Annotated[str, "tag"],
    numbered: Annotated[int, "n"],
    maybe: str | None,
    listed: list[str],
) -> list[object]:
    annotated: object = "x"
    prefixed = f"b{label}"
    repeated = "ab"
    repeated *= 2
    try:
        pass
    except ValueError as caught:
        pass
    match label:
        case "a":
            pass
        case str() as matched:
            pass
        case [*rest]:
            pass
        case {**extra}:
            pass
    return [
        f"a{prefixed}",
        f"{label or "none"}x",
        "a" + listed.pop(),
        "a" + (lambda: label)(),
        "a" + concat_undefined,
        "a" + annotated,
        "a" + repeated,
        "a" + caught,
        "a" + matched,
        f"{quoted}!",
        f"{tagged}!",
        numbered + "!",
        maybe + "!",
    ]


def concat_declared_global() -> str:
    global concat_counter
    return "a" + concat_counter


def concat_comprehension(label: str, listed: list[str]) -> list[str]:
    return [f"a{label}" for label in listed]


def concat_nested_sum(label: str) -> str:
    return f"a{f"b{label}"}"
