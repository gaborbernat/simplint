    chain7 = chain6
    chain7 += chain7
    chain8 = chain7
    chain8 += chain8
    chain9 = chain8
    chain9 += chain9
    chain10 = chain9
    chain10 += chain10
    chain11 = chain10
    chain11 += chain11
    chain12 = chain11
    chain12 += chain12
    chain13 = chain12
    chain13 += chain13
    chain14 = chain13
    chain14 += chain14
    chain15 = chain14
    chain15 += chain15
    chain16 = chain15
    chain16 += chain16
    chain17 = chain16
    chain17 += chain17
    chain18 = chain17
    chain18 += chain18
    chain19 = chain18
    chain19 += chain19
    chain20 = chain19
    chain20 += chain20
    chain21 = chain20
    chain21 += chain21
    chain22 = chain21
    chain22 += chain22
    chain23 = chain22
    chain23 += chain23
