import logging

logger = logging.getLogger(__name__)


def greet(name: str, count: int) -> None:
    logger.info("Hello, " + name)
    logger.info(msg="Hello, " + name)
    logging.log(logging.INFO, "Hello, " + name)
    logger.info((f"Hello, {name}") * 2)
    print(f"Hello, {name}")


def label() -> str:
    return (
        "Hello, "
        + "world"
    )
