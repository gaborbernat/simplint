import datetime as dt


def parse_day(text):
    return dt.date.strptime(text, "%Y-%m-%d")


def parse_time(text):
    return dt.time.strptime(text, "%H:%M")


def from_function(text):
    from datetime import datetime

    return datetime.strptime(text, "%Y").date()
