import re
from typing import Final


_OUTER_PATTERN: Final[re.Pattern[str]] = re.compile(r"a\d")


_OUTER_PATTERN_2: Final[re.Pattern[str]] = re.compile(r"b\d")


def outer(text):
    return _OUTER_PATTERN.match(_OUTER_PATTERN_2.search(text))
