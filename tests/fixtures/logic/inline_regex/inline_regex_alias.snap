import re
from typing import Final


_STRANDED_PATTERN: Final[re.Pattern[str]] = re.compile(r"#\s*(\d+)")


def stranded(lines):
    return [line for line in lines if _STRANDED_PATTERN.search(line)]


_VERSION_RE: Final[re.Pattern[str]] = re.compile(r"v\d+")


def version(text):
    if _VERSION_RE.match(text):
        return _VERSION_RE.pattern
    return None


_SCAN_PATTERN: Final[re.Pattern[str]] = re.compile(r"q")


def closure(text):

    def inner(item):
        return _SCAN_PATTERN.match(item)

    return inner(text)


_REBOUND_PATTERN: Final[re.Pattern[str]] = re.compile(r"s")

_REBOUND_PATTERN_2: Final[re.Pattern[str]] = re.compile(r"t")


def rebound(text):
    scan = _REBOUND_PATTERN
    scan = _REBOUND_PATTERN_2
    return scan.match(text)


_DELETED_PATTERN: Final[re.Pattern[str]] = re.compile(r"s")


def deleted(text):
    scan = _DELETED_PATTERN
    del scan
    return text


_DECLARED_PATTERN: Final[re.Pattern[str]] = re.compile(r"u")


def declared(text):
    scan = _DECLARED_PATTERN

    def inner():
        nonlocal scan
        return scan

    return inner()


_READ_BY_CALL_PATTERN: Final[re.Pattern[str]] = re.compile(r"p")

_READ_BY_CALL_PATTERN_2: Final[re.Pattern[str]] = re.compile(r"x")


def read_by_call(text):
    scan = _READ_BY_CALL_PATTERN
    return _READ_BY_CALL_PATTERN_2.match(scan.pattern) and text


_DEBUG_TEXT_PATTERN: Final[re.Pattern[str]] = re.compile(r"d")


def debug_text(text):
    scan = _DEBUG_TEXT_PATTERN
    return f"{scan=}"


_COMMENTED_PATTERN: Final[re.Pattern[str]] = re.compile(r"z")


def commented(text):
    scan = _COMMENTED_PATTERN  # the z form
    return scan.match(text)


_EXPLANATION_PATTERN: Final[re.Pattern[str]] = re.compile(r"a\d")

_EXPLAIN_PATTERN: Final[re.Pattern[str]] = re.compile(r"c\d")


def explain(text):
    explanation = _EXPLANATION_PATTERN.sub("b", text)
    explanation = _EXPLAIN_PATTERN.sub("d", explanation)
    return explanation


_BOUND_IN_A_BLOCK_PATTERN: Final[re.Pattern[str]] = re.compile(r"n")


def bound_in_a_block(text, flag):
    if flag:
        scan = _BOUND_IN_A_BLOCK_PATTERN
        return scan.match(text)
    return None


_READ_IN_A_TEMPLATE_PATTERN: Final[re.Pattern[str]] = re.compile(r"m")


def read_in_a_template(text):
    scan = _READ_IN_A_TEMPLATE_PATTERN
    return t"{scan}", text


_OTHER_NONLOCAL_PATTERN: Final[re.Pattern[str]] = re.compile(r"o")


def other_nonlocal(text):
    count = 0

    def bump():
        nonlocal count
        count += 1

    bump()
    return _OTHER_NONLOCAL_PATTERN.match(text), count
