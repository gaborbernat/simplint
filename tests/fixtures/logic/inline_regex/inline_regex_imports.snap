import re
from re import fullmatch
from typing import Callable, Final


_IS_WORD_PATTERN: Final[re.Pattern[str]] = re.compile(r"\w+")


def is_word(text: str) -> bool:
    return _IS_WORD_PATTERN.fullmatch(text) is not None


_WORD_CHECK_PATTERN: Final[re.Pattern[str]] = re.compile(r"\w+")


def word_check(check: Callable[[str], bool]) -> bool:
    return check(_WORD_CHECK_PATTERN.fullmatch("x") is not None)
