import os
# /// script
# requires-python = ">=3.12"
# ///

# Setup
# -> arrow is fine
# a regular comment explains why
#!/not-a-shebang
VALUE = os.sep  # ---- trailing is fine
# ...
# compiled as C++
# >>> run(1)
# ++ counter
# the parser coerces both operands, but neither
# is a shape the checker vouches for, so both keep ===

# remove return to update cron
## the lock must be held while the queue drains
# start of the generated code
# built with modern C++
# the lock must hold
# __getattribute__ triggered through __getattr__
# __init__ wires the parser


def negotiate(requested: bool, configured: bool) -> bool:
    #   Config  Req.    Resp.
    #   ------  ------  ------
    #   False   False   False
    return requested or configured


def flow(column: int, indent: int) -> bool:
    ## The stricter condition would reject intuitively correct
    ## constructions such as
    ## a mapping that opens on the key line.
    return indent > column


## https://yaml.org/spec/1.2.2/
## tokens.append(token)
## Remove this
LAST = 1
