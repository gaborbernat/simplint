import dataclasses
from dataclasses import dataclass


@dataclass(kw_only=True)
class Plain:
    value: int


@dataclasses.dataclass(frozen=True, slots=True, kw_only=True)
class Options:
    value: int


@dataclass(kw_only=True)
class OptedOut:
    value: int


@dataclass(kw_only=True)
class Done:
    value: int
