from dataclasses import InitVar, dataclass
from typing import Any, ClassVar

import pytest


@dataclass
class ArrowValue:
    dtype: str
    arrow_type: ClassVar[Any] = None

    def __post_init__(self) -> None:
        self.arrow_type = self.dtype


@dataclass
class Marker:
    text: str
    flow_marker: ClassVar[str] = ">"


def remark(formatter: object) -> None:
    formatter.flow_marker = "|"


@dataclass
class Seeded:
    seeded_total: int
    seed: InitVar[int]

    def __post_init__(self, seed: int) -> None:
        self.seed = seed


@dataclass(frozen=True)
class ProviderMapping:
    provider: str

    def __init__(self, **kwargs: Any) -> None:
        self.__dict__.update(**kwargs)


@dataclass(frozen=True)
class HookedConfiguration:
    server: str


class HookedClient:
    configuration: HookedConfiguration

    def __init__(self, configuration: object) -> None:
        self.configuration = configuration

    def hooks(self) -> object:
        return vars(self.configuration)["hooks"]


@dataclass(frozen=True)
class SettingsSchema:
    profile: str


class LiveSettings(SettingsSchema):
    def __init__(self, profile: str) -> None:
        super().__init__(profile=profile)
        self._comments = None


@dataclass
class UnhashableKey:
    text: str


def test_unhashable_key() -> None:
    with pytest.raises(TypeError):
        _ = {UnhashableKey("a"): True}


@dataclass
class DefaultOptions:
    """A dataclass declared with the default options."""


@dataclass(frozen=True, slots=True)
class PlainRuntime:
    text: str
