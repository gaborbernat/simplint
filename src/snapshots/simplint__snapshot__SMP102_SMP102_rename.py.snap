3:1 SMP102 Module-scope variable `counter` should be named `_COUNTER` [unsafe fix]
--- fixed (1 applied, 0 remaining) ---
import functools

_COUNTER = 1


def decorate(function: object) -> object:
    return function


@decorate
class Holder(dict):
    doubled = _COUNTER * 2

    def method(self, value: int = _COUNTER) -> int:
        return value + _COUNTER


def nested() -> int:
    total = 0

    def inner() -> int:
        nonlocal total
        total += _COUNTER
        return total

    return inner()


def bump() -> None:
    global _COUNTER
    _COUNTER += 1
    del _COUNTER


def scopes(items: list[int]) -> list[int]:
    first = [_COUNTER + item for item in items]
    third = {key: _COUNTER for key in items}
    fifth = lambda value=_COUNTER: value + _COUNTER
    if (named := _COUNTER) > 0:
        pass
    match items:
        case [head, *tail] if head == _COUNTER:
            return [head, *tail, named]
    return [*first, *third.values(), fifth()]


functools.reduce(lambda left, right: left + _COUNTER, [_COUNTER])


def generators(items: list[int]) -> list[int]:
    return [first + _COUNTER for first in items for second in items if second] + [0 for Holder.doubled in items]
