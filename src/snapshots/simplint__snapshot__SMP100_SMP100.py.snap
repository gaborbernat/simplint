import re


def match(text: str) -> str:
    if found := re.match("a", text):
        return found.group(0)
    if len(text) > 3 and text:
        return text
    if not text.strip():
        return ""
    reused = text.lower()
    if reused:
        pass
    return reused


def keep(text: str) -> str:
    pair = 1, 2
    if pair:
        return text
    commented = text  # keep this
    if commented:
        return commented
    late = text
    if text:
        return late
    return ""


