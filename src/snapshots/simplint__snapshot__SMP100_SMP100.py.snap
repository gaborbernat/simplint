def shapes(text: str) -> object:
    if text.strip():
        pass
    if (len(text) + 1) > 3:
        pass
    if (again := text.lower()) > "a":
        return again
    first, second = text, text
    if first:
        return second
    called = text.upper()
    if len(called):
        return called
    return None
