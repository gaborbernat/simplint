import dataclasses
import functools
from dataclasses import dataclass, field


@dataclass(frozen=True, slots=True, kw_only=True)
class Plain:
    value: int


@dataclasses.dataclass(order=True, frozen=True, slots=True, kw_only=True)
class Ordered:
    value: int


@dataclass(frozen=True, slots=True, kw_only=True)
class Done:
    values: list[int] = field(default_factory=list)


@dataclass(frozen=True, slots=True, kw_only=True)
class Mutable:
    value: int


@functools.total_ordering
class Ordering:
    value: int
