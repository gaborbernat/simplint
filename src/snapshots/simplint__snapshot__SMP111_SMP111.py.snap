import dataclasses
import functools
from dataclasses import dataclass, field


@dataclass(frozen=True, slots=True)
class Plain:
    width: int


@dataclasses.dataclass(order=True, kw_only=True, frozen=True, slots=True)
class Ordered:
    rank: int


@dataclass(frozen=True, slots=True)
class Done:
    values: list[int] = field(default_factory=list)


@dataclass(frozen=True, slots=True)
class OptedOut:
    height: int


@dataclass(frozen=True, slots=True)
class Base:
    depth: int


@dataclass(frozen=True, slots=True)
class Child(Base):
    extra: int


@dataclass(frozen=True, slots=True)
class Counter:
    count: int


@dataclass(frozen=True, slots=True)
class Labelled:
    label: str


@dataclass(frozen=True, slots=True)
class Cached:
    value: int

    @functools.cached_property
    def doubled(self) -> int:
        return self.value * 2


@dataclass(frozen=True, slots=True)
class Initialized:
    value: int

    def __post_init__(self) -> None:
        self.total = self.value


@dataclass(frozen=True, slots=True)
class Guarded:
    size: int

    def __delattr__(self, name: str) -> None:
        raise AttributeError(name)


@functools.total_ordering
class Ordering:
    value: int


def bump(counter: Counter, labelled: Labelled) -> None:
    counter.count += 1
    setattr(labelled, "label", "new")
