from unittest.mock import MagicMock, create_autospec


def run() -> int:
    return 1


def test_mocks() -> None:
    first = MagicMock(spec=run, return_value=3, side_effect=None)
    second = create_autospec(run, return_value=4)
    second.name = "special"
    third = MagicMock(spec=run, return_value=1)
    third.total = third
    fourth = MagicMock(spec=run,)
    fourth.value = 2  # explained
    fifth = MagicMock(spec=run, value=2)
    assert first() + second() + third() + fourth() + fifth()


def test_more() -> None:
    plain = run()
    plain.value = 1
    sixth = MagicMock(value=3)
    assert plain and sixth
